# Copy to .env and fill in. NEVER commit .env or paste its values into a chat.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/raktsetu?retryWrites=true&w=majority
PORT=5000
# The whole Firebase service-account JSON on ONE single line
FIREBASE_SERVICE_ACCOUNT_JSON=
CORS_ORIGIN=http://localhost:5173
# Gmail + 16-character app password (needs 2-step verification)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Firebase User UIDs (not emails) of admins, comma-separated
ADMIN_UIDS=
