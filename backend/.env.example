# MongoDB Atlas connection string (from your M0 cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/raktsetu?retryWrites=true&w=majority

# Port the server runs on locally (Render sets this automatically in production)
PORT=5000

# Firebase Admin SDK service account (see README step 2)
# Paste the ENTIRE contents of your downloaded serviceAccountKey.json as ONE line here
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:5173
